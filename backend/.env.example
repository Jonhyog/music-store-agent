# Copy to .env and adjust. Values shown are the defaults.
DATABASE_PATH=music_store.db
CORS_ORIGINS=["http://localhost:5173"]
REFERENCE_DATE=2026-03-25

# Models: qwen3:4b, qwen3:8b (Ollama) and gpt-6-luna (OpenAI).
DEFAULT_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty to mark the API model unavailable.
OPENAI_API_KEY=

# Optional LangSmith tracing: set LANGSMITH_TRACING=true and a key to enable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=music-store-assistant
